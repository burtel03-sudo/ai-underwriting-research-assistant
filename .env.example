# Copy to .env and fill in. Never commit the real .env file (see .gitignore).
# Per SEC-02: no secrets in code or version control.

APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/underwriting

# Auth — enterprise SSO (FR-001). Leave unset until an IdP is approved (PRD §18).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# LLM provider — thin adapter, no provider lock-in. Leave unset until approved (PRD §18).
LLM_PROVIDER=
LLM_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
